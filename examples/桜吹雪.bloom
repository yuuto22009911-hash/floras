※ 桜吹雪 ─ 散らす で 60 個のかべんを背景に散布
色見本 春 {
  桜色 知覚色(0.85 0.10 12);
  紙   知覚色(0.97 0.01 80);
  墨   知覚色(0.22 0.02 30);
}

花 かべん {
  花弁数 5;
  大きさ 80;
  色 春.桜色;
  花弁反り 0.4;
  花弁切込 0.45;
  雄蕊数 0;
  輪郭 春.墨 幅 0.6;
}

花 しゅやくざくら {
  花弁数 5;
  大きさ 320;
  色 春.桜色;
  花弁反り 0.4;
  花弁切込 0.45;
  雄蕊数 14;
  雄蕊色 春.墨;
  輪郭 春.墨 幅 1.2;
}

花束 ヒーロー {
  画布 1200 × 630;
  背景 春.紙;

  散らす 背景花弁 {
    元 かべん;
    数 60;
    領域 画布;
    大きさ 16..56;
    回転 乱数;
    色 春.桜色 混ぜ 春.紙 0.4;
    種 42;
  }

  置く しゅやくざくら に 中央;
}
