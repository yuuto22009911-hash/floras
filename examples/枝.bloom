※ 枝 ─ 模様で「さくら と 蕾 ２つ」をひと枝として再利用
色見本 春 {
  桜色 知覚色(0.85 0.10 12);
  紙   知覚色(0.97 0.01 80);
  墨   知覚色(0.22 0.02 30);
  蕾色 知覚色(0.78 0.13 5);
}

花 さくら {
  花弁数 5;
  大きさ 110;
  色 春.桜色;
  花弁反り 0.4;
  花弁切込 0.45;
  雄蕊数 10;
  雄蕊色 春.墨;
  輪郭 春.墨 幅 0.8;
}

花 つぼみ {
  花弁数 5;
  大きさ 50;
  色 春.蕾色;
  花弁反り 0.6;
  花弁切込 0.1;
  雄蕊数 0;
  輪郭 春.墨 幅 0.5;
}

模様 ひとえだ {
  ※ 中央の本花 + 両脇の蕾 2 つを 1 セットに
  置く さくら   に (0, 0);
  置く つぼみ に (-50, -30);
  置く つぼみ に (45, 35);
}

花束 ヒーロー {
  画布 1200 × 630;
  背景 春.紙;

  ※ 模様 を散布 ─ 8 個の枝が散らばる
  散らす 枝群 {
    元 ひとえだ;
    数 8;
    領域 矩形 (60, 80) へ (1140, 560);
    種 11;
  }

  ※ 中央には大きい主役さくら
  置く さくら に 中央 {
    大きさ 320;
    雄蕊数 16;
  };
}
