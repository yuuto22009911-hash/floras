shion 百合 ─ 6 弁、palette 連携サンプル
palette monofloras {
  primary  oklch(0.85 0.07 80);
  ink      #2C2825;
  accent   #C77D4E;
}

bloom yuri {
  petals 6;
  size 280;
  color monofloras.primary;
  petal-curl 0.5;
  petal-notch 0;
  petal-width 60;
  petal-height 130;
  stamen-count 6;
  stamen-radius 8;
  stamen-color monofloras.accent;
  stroke monofloras.ink width 1.2;
}
