※ ヒーローセクション ─ 桜と百合を 1200×630 のキャンバスに配置
色見本 春 {
  桜色 知覚色(0.85 0.10 12);
  紙   知覚色(0.97 0.01 80);
  墨   知覚色(0.22 0.02 30);
  紅   知覚色(0.55 0.18 25);
  挿   知覚色(0.65 0.14 60);
  本体 知覚色(0.85 0.07 80);
}

花 桜 {
  花弁数 5;
  大きさ 280;
  色 春.桜色;
  花弁反り 0.4;
  花弁切込 0.45;
  雄蕊数 14;
  雄蕊色 春.紅;
  輪郭 春.墨 幅 1.2;
}

花 百合 {
  花弁数 6;
  大きさ 240;
  色 春.本体;
  花弁反り 0.5;
  花弁切込 0;
  花弁幅 50;
  花弁丈 110;
  雄蕊数 6;
  雄蕊半径 8;
  雄蕊色 春.挿;
  輪郭 春.墨 幅 1.2;
}

花束 ヒーロー {
  画布 1200 × 630;
  背景 春.紙;

  置く 百合 に (380, 320);
  置く 桜   に (820, 320);
  置く 桜   に (1080, 470) {
    大きさ 140;
    色 春.桜色 混ぜ 春.紙 0.4;
  };
  置く 桜   に (160, 480) {
    大きさ 120;
    色 春.桜色 混ぜ 春.紙 0.5;
  };
}
